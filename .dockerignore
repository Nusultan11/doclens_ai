**/reports/extraction
**/reports/chunking

# Local model stores are root-only: src/doclens_ai/models is application code.
# Model assets are supplied by read-only runtime mounts, never Dockerfile COPY.
models
model-weights
weights
checkpoints
hf-cache
.huggingface
**/.cache/huggingface
**/*.safetensors
**/*.gguf
**/*.ggml
**/*.ckpt
**/*.pt
**/*.pth
**/*.onnx

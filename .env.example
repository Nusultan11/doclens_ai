APP_NAME=DocLens AI
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://doclens:doclens-local@localhost:5432/doclens
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_REQUIRED_SCOPE=doclens:documents
OIDC_JWKS_TIMEOUT_SECONDS=3
OIDC_JWKS_CACHE_TTL_SECONDS=300
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=doclens-local
S3_SECRET_KEY=doclens-local-secret
S3_BUCKET_NAME=doclens-documents
S3_REGION=us-east-1
S3_SECURE=false
S3_MAX_UPLOAD_SIZE_BYTES=52428800
